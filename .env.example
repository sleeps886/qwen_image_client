# HTTP server settings. Restart the backend after changes.
APP_HOST=127.0.0.1
APP_PORT=8870
# Comma-separated hostnames/IPs, without protocol or port. No wildcard.
APP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Anthropic Messages relay example. Use placeholders only; never commit real keys.
MODEL_API_FORMAT=anthropic
MODEL_AUTH_MODE=bearer
MODEL_API_KEY=replace-with-your-key
MODEL_NAME=qwen3.8-omni-flash
MODEL_BASE_URL=https://www.dmxapi.cn/v1
MODEL_MAX_TOKENS=8192
# Anthropic-compatible relay: request no extended thinking. Set auto if unsupported.
# This is a protocol request, not a guarantee that the relay/model honors it.
MODEL_THINKING_MODE=disabled
# Local tracking assumptions (not ground truth; leave unset to use defaults).
# TRACK_MAX_SPEED_MPS=30
# TRACK_MAX_ACCELERATION_MPS2=0.5
# TRACK_ACCELERATION_PRIOR_MPS2=0.1
# TRACK_BEARING_SIGMA_DEG=1
# TRACK_MAX_ANGLE_ERROR_DEG=2
# TRACK_WINDOW_POINTS=9
# TRACK_MAX_GAP_S=56.4
# Experimental evidence density. Default 16; 48 is NOT accuracy-validated.
# SONAR_EVIDENCE_TIME_SLICES=48
# For OpenAI-compatible endpoints: MODEL_API_FORMAT=openai and MODEL_AUTH_MODE=bearer.
# MODEL_REASONING_EFFORT=low  (OpenAI format only; never sent in Anthropic requests)
